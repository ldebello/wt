#!/usr/bin/env bash

set -euo pipefail

# ------------------------------------------------------------
# Helpers
# ------------------------------------------------------------

print_usage() {
    cat <<'EOF'
wt - git worktree helper

Usage:
  wt clone <git-url>     Clone a repo into a bare-repo + worktrees layout
  wt <branch>            Create (or reuse) a worktree for <branch>
  wt <branch> --from <base-branch>
                         Create <branch> as a new branch starting from
                         <base-branch> instead of the default branch
  wt remove <branch>     Remove a worktree and its local branch
  wt cleanup             Remove every worktree except primary, then update
  wt update              Fetch all remotes, fast-forward primary, and list worktrees
  wt workspace <name> --repos <r1,r2,...> [--repo-base <dir>]
                         Create (or update) a multi-repo workspace: one
                         worktree per repo, all rooted under
                         <parent-of-repo-base>/workspaces/<name>/<repo>,
                         all on branch <name>. <repo-base> is where the
                         repos themselves live (default ~/repos); the
                         'workspaces' folder is created next to it, not
                         inside it.
  wt workspace remove <name> [--repo-base <dir>]
                         Remove every worktree in a workspace, then the
                         workspace directory itself
  wt help                Show this help

Layout created by 'wt clone':
  <repo>/.bare           Bare git repository (do not touch)
  <repo>/.git            Points to .bare
  <repo>/primary         Permanent worktree checked out on the default branch
  <repo>/<branch>        Worktree created on demand by 'wt <branch>'

Layout created by 'wt workspace' (with the default --repo-base of ~/repos):
  ~/workspaces/<name>/<repo>
                         One worktree per repo listed in --repos, all
                         checked out on branch <name>. 'workspaces' is a
                         sibling of the repos base directory, not nested
                         inside it.
  ~/workspaces/<name>/.wt-workspace
                         Metadata (name, repo_base, repos) read back by
                         'wt workspace remove'. Don't edit by hand.

Notes:
  - 'primary' is treated as permanent and 'wt remove' refuses to touch it.
  - Run 'wt <branch>' / 'wt remove <branch>' from anywhere inside the repo
    (the bare root or any worktree).
  - If a worktree directory is deleted manually (e.g. 'rm -rf') instead of
    via 'wt remove', 'wt <branch>' and 'wt update' clean up the stale
    registration automatically.
  - 'wt update' fast-forwards 'primary' to its upstream, but only if
    primary has no local changes and can be fast-forwarded cleanly;
    otherwise it warns and leaves primary untouched.
  - 'wt cleanup' skips (and reports) any worktree with uncommitted
    changes; a removed worktree whose branch isn't fully merged keeps
    its local branch around. It never touches remote branches -- use
    'wt remove <branch>' for that.
  - '--from <base-branch>' only applies when <branch> doesn't exist yet
    (locally or on origin); if it already exists, --from is ignored with
    a warning and the existing branch/worktree is reused as usual.
  - A workspace's <name> is also the branch name checked out in every
    one of its repos, so unlike a plain <branch>, it can't contain '/'.
  - 'wt workspace' re-run on an existing workspace reuses worktrees that
    already exist and only creates the ones that are missing (e.g. after
    adding a repo to --repos).
  - 'wt cleanup' never touches worktrees that live under a workspace
    (the 'workspaces' folder next to the repos base dir) -- use
    'wt workspace remove <name>' for those.
  - If WT_CODEGRAPH=true, 'wt workspace' runs 'codegraph init' the first
    time and 'codegraph index --force' on later re-runs, from the
    workspace root. Unset or not "true", codegraph is never invoked. See
    README for how to install codegraph.
EOF
}

REPO_ROOT=""
WORKSPACES_ROOT=""

require_repo() {
    if ! git rev-parse --git-common-dir >/dev/null 2>&1; then
        echo "Error: not inside a git repository." >&2
        echo "Run 'wt clone <git-url>' first, or 'cd' into an existing repo." >&2
        exit 1
    fi

    # Root of the bare-repo + worktrees layout (parent of .bare), regardless
    # of whether we're invoked from the bare root or from inside a worktree.
    REPO_ROOT="$(cd "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")" && pwd)"

    # Where 'wt workspace' puts its workspaces: a sibling of the repos base
    # directory (e.g. repos in ~/repos -> workspaces in ~/workspaces), not
    # nested inside it. Only used to tell workspace-owned worktrees apart
    # from regular ones.
    WORKSPACES_ROOT="$(dirname "$(dirname "$REPO_ROOT")")/workspaces"
}

validate_branch_name() {
    local branch="$1"

    if [ -z "$branch" ]; then
        echo "Error: branch name cannot be empty." >&2
        exit 1
    fi

    if [[ "$branch" == -* ]]; then
        echo "Error: invalid branch name '$branch'." >&2
        exit 1
    fi
}

# Validates a plain single-path-segment name (workspace name, repo name):
# non-empty, not an option-looking string, no slashes.
validate_simple_name() {
    local label="$1" value="$2"

    if [ -z "$value" ]; then
        echo "Error: $label cannot be empty." >&2
        exit 1
    fi

    if [[ "$value" == -* || "$value" == */* ]]; then
        echo "Error: invalid $label '$value'." >&2
        exit 1
    fi
}

worktree_exists_for_branch() {
    local branch="$1"
    git worktree list --porcelain | grep -q "^branch refs/heads/$branch\$"
}

# Path of the worktree checked out on <branch> in the repo at <repo_root>,
# or nothing (exit 1) if <branch> has no worktree there.
worktree_path_for_branch() {
    local repo_root="$1" branch="$2"
    git -C "$repo_root" worktree list --porcelain | awk -v b="refs/heads/$branch" '
        /^worktree / { path = substr($0, 10) }
        $0 == "branch " b { print path; found=1 }
        END { exit !found }
    '
}

# Removes now-empty parent directories left behind by a removed worktree
# (e.g. nested branch names like feature/foo), stopping at (and never
# removing) <floor>.
rmdir_empty_parents() {
    local path="$1" floor="$2" parent
    parent="$(dirname "$path")"
    while [ "$parent" != "$floor" ] && [ -d "$parent" ] && [ -z "$(ls -A "$parent")" ]; do
        rmdir "$parent"
        parent="$(dirname "$parent")"
    done
}

# The directory rmdir_empty_parents must not climb above for <path>: the
# owning workspace root for a workspace-owned worktree, REPO_ROOT otherwise.
floor_for_worktree() {
    local path="$1"
    case "$path" in
        "$WORKSPACES_ROOT"/*)
            local rel="${path#"$WORKSPACES_ROOT"/}"
            echo "$WORKSPACES_ROOT/${rel%%/*}"
            ;;
        *)
            echo "$REPO_ROOT"
            ;;
    esac
}

codegraph_enabled() {
    [ "${WT_CODEGRAPH:-}" = "true" ]
}

# Shared by 'wt update' and 'wt cleanup'. Assumes require_repo already ran.
run_update() {
    echo "Fetching remote branches..."
    echo

    git fetch --all --prune

    echo
    echo "Updating remote HEAD..."
    git remote set-head origin -a

    echo
    echo "Pruning stale worktree registrations..."
    git worktree prune

    PRIMARY_PATH="$REPO_ROOT/primary"

    if [ -d "$PRIMARY_PATH" ]; then
        echo
        echo "Updating primary worktree..."

        if [ -n "$(git -C "$PRIMARY_PATH" status --porcelain)" ]; then
            echo "Warning: primary has local changes, skipping update." >&2
            echo "  Update it yourself: cd '$PRIMARY_PATH' && git pull" >&2
        elif ! PRIMARY_BRANCH="$(git -C "$PRIMARY_PATH" symbolic-ref --short HEAD 2>/dev/null)"; then
            echo "Warning: primary is in detached HEAD, skipping update." >&2
            echo "  Update it yourself: cd '$PRIMARY_PATH'" >&2
        elif ! git -C "$PRIMARY_PATH" rev-parse --verify -q '@{u}' >/dev/null; then
            echo "Warning: branch '$PRIMARY_BRANCH' in primary has no upstream, skipping update." >&2
            echo "  Update it yourself: cd '$PRIMARY_PATH'" >&2
        elif git -C "$PRIMARY_PATH" merge --ff-only '@{u}' >/dev/null 2>&1; then
            echo "primary fast-forwarded to $(git -C "$PRIMARY_PATH" rev-parse --abbrev-ref '@{u}')."
        else
            echo "Warning: primary has diverged from its upstream, skipping update." >&2
            echo "  Resolve it yourself: cd '$PRIMARY_PATH'" >&2
        fi
    fi

    echo
    echo "Remote branches:"
    git --no-pager branch -r

    echo
    echo "Worktrees:"
    git worktree list

    echo
    echo "Update complete."
}


# ------------------------------------------------------------
# wt help / -h / --help / (no args)
# ------------------------------------------------------------

case "${1-}" in
    -h|--help|help)
        print_usage
        exit 0
        ;;
esac

if [ "$#" -eq 0 ]; then
    print_usage
    exit 1
fi


# ------------------------------------------------------------
# wt clone <git-url>
# ------------------------------------------------------------

if [ "$1" = "clone" ]; then

    if [ "$#" -ne 2 ]; then
        echo "Usage: wt clone <git-url>" >&2
        exit 1
    fi

    REPO_URL="$2"

    # Remove trailing slash if present
    REPO_URL="${REPO_URL%/}"

    if [ -z "$REPO_URL" ]; then
        echo "Error: git-url cannot be empty." >&2
        exit 1
    fi

    # Extract repository name
    REPO_NAME="$(basename "$REPO_URL")"
    REPO_NAME="${REPO_NAME%.git}"

    if [ -z "$REPO_NAME" ]; then
        echo "Error: could not determine repository name from '$REPO_URL'." >&2
        exit 1
    fi

    TARGET_DIR="$(pwd)/$REPO_NAME"

    echo "Repository: $REPO_NAME"

    # Do not overwrite an existing directory
    if [ -e "$TARGET_DIR" ]; then
        echo "Error: directory already exists:" >&2
        echo "  $TARGET_DIR" >&2
        exit 1
    fi

    # Clean up a partial clone if anything below fails
    cleanup_partial_clone() {
        echo
        echo "Clone failed, cleaning up:"
        echo "  $TARGET_DIR"
        rm -rf "$TARGET_DIR"
    }
    trap cleanup_partial_clone ERR

    # Create repository directory
    mkdir "$TARGET_DIR"
    cd "$TARGET_DIR"

    echo
    echo "Initializing bare repository..."

    # Init empty + fetch manually (instead of 'git clone --bare') so remote
    # branches land as remote-tracking refs (refs/remotes/origin/*), not as
    # mirrored local branches (refs/heads/*) with no upstream configured.
    git init -q --bare .bare

    # Tell Git that this directory is the worktree root
    printf 'gitdir: ./.bare\n' > .git

    git remote add origin "$REPO_URL"
    git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'

    echo
    echo "Fetching all remote branches..."

    git fetch --all --prune

    # Detect the default branch
    git remote set-head origin -a

    DEFAULT_BRANCH="$(git symbolic-ref --short refs/remotes/origin/HEAD)"
    DEFAULT_BRANCH="${DEFAULT_BRANCH#origin/}"

    echo
    echo "Default branch: $DEFAULT_BRANCH"

    # Create the primary worktree from the existing remote branch
    echo
    echo "Creating primary worktree..."

    git worktree add --track -b "$DEFAULT_BRANCH" primary "origin/$DEFAULT_BRANCH"

    trap - ERR

    echo
    echo "Done."
    echo
    echo "Repository:"
    echo "  $TARGET_DIR"
    echo
    echo "Primary worktree:"
    echo "  $TARGET_DIR/primary"
    echo
    echo "Default branch:"
    echo "  $DEFAULT_BRANCH"

    exit 0
fi


# ------------------------------------------------------------
# wt update
# ------------------------------------------------------------

if [ "$1" = "update" ]; then

    if [ "$#" -ne 1 ]; then
        echo "Usage: wt update" >&2
        exit 1
    fi

    require_repo
    run_update
    exit 0
fi


# ------------------------------------------------------------
# wt remove <branch>
# ------------------------------------------------------------

if [ "$1" = "remove" ]; then

    if [ "$#" -ne 2 ]; then
        echo "Usage: wt remove <branch>" >&2
        exit 1
    fi

    require_repo

    BRANCH="$2"
    validate_branch_name "$BRANCH"

    if [ "$BRANCH" = "primary" ]; then
        echo "Error: 'primary' is the permanent worktree and cannot be removed." >&2
        exit 1
    fi

    WORKTREE_PATH="$(worktree_path_for_branch "$REPO_ROOT" "$BRANCH" || true)"

    if [ -z "$WORKTREE_PATH" ]; then
        echo "Error: no worktree found for branch '$BRANCH'." >&2
        echo
        git worktree list
        exit 1
    fi

    echo "Removing worktree: $WORKTREE_PATH"
    if ! git worktree remove "$WORKTREE_PATH"; then
        echo
        echo "Hint: if the worktree has uncommitted changes, retry with:" >&2
        echo "  git worktree remove --force '$WORKTREE_PATH'" >&2
        exit 1
    fi

    rmdir_empty_parents "$WORKTREE_PATH" "$(floor_for_worktree "$WORKTREE_PATH")"

    echo "Deleting local branch: $BRANCH"
    if ! git branch -d "$BRANCH"; then
        echo
        echo "Hint: if the branch isn't fully merged, force-delete it with:" >&2
        echo "  git branch -D '$BRANCH'" >&2
        exit 1
    fi

    echo
    read -r -p "Delete origin/$BRANCH as well? [y/N] " -n 1 REPLY
    echo
    if [[ "$REPLY" =~ ^[Yy]$ ]]; then
        echo "Deleting origin/$BRANCH..."
        git push origin --delete "$BRANCH"
    fi

    echo
    echo "Remove complete."
    exit 0
fi


# ------------------------------------------------------------
# wt cleanup
# ------------------------------------------------------------

if [ "$1" = "cleanup" ]; then

    if [ "$#" -ne 1 ]; then
        echo "Usage: wt cleanup" >&2
        exit 1
    fi

    require_repo

    echo "Removing worktrees other than 'primary'..."
    echo

    REMOVED=0
    SKIPPED=0
    SKIPPED_WORKSPACE=0

    while IFS=$'\t' read -r WORKTREE_PATH BRANCH; do
        if [ "$WORKTREE_PATH" = "$REPO_ROOT/primary" ]; then
            continue
        fi

        case "$WORKTREE_PATH" in
            "$WORKSPACES_ROOT"/*)
                SKIPPED_WORKSPACE=$((SKIPPED_WORKSPACE + 1))
                continue
                ;;
        esac

        if ! git worktree remove "$WORKTREE_PATH" >/dev/null 2>&1; then
            echo "Skipped '$BRANCH': has uncommitted changes (or is locked)."
            SKIPPED=$((SKIPPED + 1))
            continue
        fi

        rmdir_empty_parents "$WORKTREE_PATH" "$REPO_ROOT"

        # Remote branches are never touched by 'wt cleanup' -- use
        # 'wt remove <branch>' if you also want to delete the remote branch.
        if git branch -d "$BRANCH" >/dev/null 2>&1; then
            echo "Removed '$BRANCH' (worktree + local branch)."
        else
            echo "Removed worktree for '$BRANCH', kept branch (not fully merged)."
        fi
        REMOVED=$((REMOVED + 1))

    done < <(git worktree list --porcelain | awk '
        /^worktree / { path = $2 }
        /^branch refs\/heads\// { print path "\t" substr($2, 12) }
    ')

    echo
    echo "Cleanup: removed $REMOVED worktree(s), skipped $SKIPPED."
    if [ "$SKIPPED_WORKSPACE" -gt 0 ]; then
        echo "Left $SKIPPED_WORKSPACE workspace-owned worktree(s) untouched -- use 'wt workspace remove <name>'."
    fi
    echo

    run_update

    exit 0
fi


# ------------------------------------------------------------
# wt workspace <name> --repos <r1,r2,...> [--repo-base <dir>]
# wt workspace remove <name> [--repo-base <dir>]
# ------------------------------------------------------------

if [ "$1" = "workspace" ]; then
    shift

    if [ "${1-}" = "" ]; then
        echo "Usage: wt workspace <name> --repos <repo1,repo2,...> [--repo-base <dir>]" >&2
        echo "       wt workspace remove <name> [--repo-base <dir>]" >&2
        exit 1
    fi


    # --------------------------------------------------------
    # wt workspace remove <name> [--repo-base <dir>]
    # --------------------------------------------------------

    if [ "$1" = "remove" ]; then
        shift

        if [ "$#" -lt 1 ]; then
            echo "Usage: wt workspace remove <name> [--repo-base <dir>]" >&2
            exit 1
        fi

        WS_NAME="$1"
        shift
        WS_REPO_BASE="$HOME/repos"

        if [ "$#" -gt 0 ]; then
            if [ "$1" != "--repo-base" ] || [ "$#" -ne 2 ]; then
                echo "Usage: wt workspace remove <name> [--repo-base <dir>]" >&2
                exit 1
            fi
            WS_REPO_BASE="$2"
        fi

        validate_simple_name "workspace name" "$WS_NAME"

        if [ ! -d "$WS_REPO_BASE" ]; then
            echo "Error: repo base directory '$WS_REPO_BASE' does not exist." >&2
            exit 1
        fi
        WS_REPO_BASE="$(cd "$WS_REPO_BASE" && pwd)"
        WS_ROOT="$(dirname "$WS_REPO_BASE")/workspaces/$WS_NAME"

        if [ ! -f "$WS_ROOT/.wt-workspace" ]; then
            echo "Error: no workspace metadata at '$WS_ROOT/.wt-workspace'." >&2
            echo "(pass --repo-base if this workspace was created with a non-default one)" >&2
            exit 1
        fi

        WS_REPOS="$(grep '^repos=' "$WS_ROOT/.wt-workspace" | cut -d= -f2-)"
        IFS=',' read -r -a REPO_ARR <<< "$WS_REPOS"

        echo "Workspace '$WS_NAME' (branch '$WS_NAME' in each repo):"
        for repo in "${REPO_ARR[@]}"; do
            echo "  - $repo"
        done
        echo

        read -r -p "Remove all worktrees and local branches above? [y/N] " -n 1 REPLY
        echo
        if [[ ! "$REPLY" =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 0
        fi

        read -r -p "Also delete the matching origin branch in each repo? [y/N] " -n 1 REPLY_REMOTE
        echo
        echo

        for repo in "${REPO_ARR[@]}"; do
            REPO_ROOT_I="$WS_REPO_BASE/$repo"
            WORKTREE_PATH="$WS_ROOT/$repo"

            if [ ! -d "$REPO_ROOT_I/.bare" ]; then
                echo "[$repo] not a wt-layout repo under '$WS_REPO_BASE', skipping."
                continue
            fi

            if [ ! -d "$WORKTREE_PATH" ]; then
                echo "[$repo] no worktree at '$WORKTREE_PATH', skipping."
                continue
            fi

            if ! git -C "$REPO_ROOT_I" worktree remove "$WORKTREE_PATH" 2>/dev/null; then
                echo "[$repo] has uncommitted changes (or is locked), skipping -- remove it yourself with:"
                echo "    git -C '$REPO_ROOT_I' worktree remove --force '$WORKTREE_PATH'"
                continue
            fi

            if git -C "$REPO_ROOT_I" branch -d "$WS_NAME" >/dev/null 2>&1; then
                echo "[$repo] removed worktree + local branch."
            else
                echo "[$repo] removed worktree, kept branch (not fully merged)."
            fi

            if [[ "$REPLY_REMOTE" =~ ^[Yy]$ ]]; then
                git -C "$REPO_ROOT_I" push origin --delete "$WS_NAME" 2>/dev/null \
                    && echo "[$repo] deleted origin/$WS_NAME." \
                    || echo "[$repo] no origin/$WS_NAME to delete."
            fi
        done

        rm -f "$WS_ROOT/.wt-workspace"
        if rmdir "$WS_ROOT" 2>/dev/null; then
            echo
            echo "Removed workspace: $WS_ROOT"
        else
            echo
            echo "Note: '$WS_ROOT' left in place (still has files -- codegraph index, or a repo that was skipped above)."
        fi

        exit 0
    fi


    # --------------------------------------------------------
    # wt workspace <name> --repos <r1,r2,...> [--repo-base <dir>]
    # --------------------------------------------------------

    if [ "$#" -lt 1 ]; then
        echo "Usage: wt workspace <name> --repos <repo1,repo2,...> [--repo-base <dir>]" >&2
        exit 1
    fi

    WS_NAME="$1"
    shift

    WS_REPO_BASE="$HOME/repos"
    WS_REPOS=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repos)
                [ "$#" -ge 2 ] || { echo "Error: --repos needs a value." >&2; exit 1; }
                WS_REPOS="$2"
                shift 2
                ;;
            --repo-base)
                [ "$#" -ge 2 ] || { echo "Error: --repo-base needs a value." >&2; exit 1; }
                WS_REPO_BASE="$2"
                shift 2
                ;;
            *)
                echo "Error: unknown option '$1'." >&2
                exit 1
                ;;
        esac
    done

    validate_simple_name "workspace name" "$WS_NAME"

    if [ -z "$WS_REPOS" ]; then
        echo "Error: --repos is required, e.g. --repos repo1,repo2,repo3." >&2
        exit 1
    fi

    if [ ! -d "$WS_REPO_BASE" ]; then
        echo "Error: repo base directory '$WS_REPO_BASE' does not exist." >&2
        exit 1
    fi
    WS_REPO_BASE="$(cd "$WS_REPO_BASE" && pwd)"

    IFS=',' read -r -a REPO_ARR <<< "$WS_REPOS"

    if [ "${#REPO_ARR[@]}" -eq 0 ]; then
        echo "Error: --repos is empty." >&2
        exit 1
    fi

    # Validate every repo up front so a typo doesn't leave the workspace
    # half-created.
    for repo in "${REPO_ARR[@]}"; do
        validate_simple_name "repo name" "$repo"
        if [ ! -d "$WS_REPO_BASE/$repo/.bare" ]; then
            echo "Error: '$WS_REPO_BASE/$repo' is not a wt-layout repo (missing .bare)." >&2
            exit 1
        fi
    done

    WS_ROOT="$(dirname "$WS_REPO_BASE")/workspaces/$WS_NAME"
    mkdir -p "$WS_ROOT"

    CREATED_REPOS=()
    CREATED_PATHS=()

    rollback_workspace() {
        echo
        echo "Error creating workspace '$WS_NAME', rolling back what was created..." >&2
        local i
        for ((i = 0; i < ${#CREATED_PATHS[@]}; i++)); do
            git -C "$WS_REPO_BASE/${CREATED_REPOS[$i]}" worktree remove --force "${CREATED_PATHS[$i]}" >/dev/null 2>&1 || true
        done
        rmdir "$WS_ROOT" 2>/dev/null || true
    }
    trap rollback_workspace ERR

    echo "Workspace: $WS_ROOT"
    echo "Branch:    $WS_NAME"
    echo

    for repo in "${REPO_ARR[@]}"; do
        REPO_ROOT_I="$WS_REPO_BASE/$repo"
        WORKTREE_PATH="$WS_ROOT/$repo"

        EXISTING_PATH="$(worktree_path_for_branch "$REPO_ROOT_I" "$WS_NAME" || true)"

        if [ -n "$EXISTING_PATH" ]; then
            if [ "$EXISTING_PATH" = "$WORKTREE_PATH" ]; then
                echo "[$repo] Reusing existing worktree: $WORKTREE_PATH"
                continue
            fi
            echo "Error: [$repo] branch '$WS_NAME' is already checked out elsewhere: $EXISTING_PATH" >&2
            # explicit 'exit' does not fire an ERR trap -- roll back by hand.
            trap - ERR
            rollback_workspace
            exit 1
        fi

        git -C "$REPO_ROOT_I" fetch --all --prune
        git -C "$REPO_ROOT_I" worktree prune

        if git -C "$REPO_ROOT_I" show-ref --verify --quiet "refs/heads/$WS_NAME"; then
            echo "[$repo] Local branch found: $WS_NAME"
            git -C "$REPO_ROOT_I" worktree add "$WORKTREE_PATH" "$WS_NAME"

        elif git -C "$REPO_ROOT_I" show-ref --verify --quiet "refs/remotes/origin/$WS_NAME"; then
            echo "[$repo] Remote branch found: origin/$WS_NAME"
            git -C "$REPO_ROOT_I" worktree add --track -b "$WS_NAME" "$WORKTREE_PATH" "origin/$WS_NAME"

        else
            DEFAULT_BRANCH_I="$(git -C "$REPO_ROOT_I" symbolic-ref --short refs/remotes/origin/HEAD)"
            DEFAULT_BRANCH_I="${DEFAULT_BRANCH_I#origin/}"
            echo "[$repo] Branch '$WS_NAME' does not exist, creating from: $DEFAULT_BRANCH_I"
            git -C "$REPO_ROOT_I" worktree add --no-track -b "$WS_NAME" "$WORKTREE_PATH" "origin/$DEFAULT_BRANCH_I"
        fi

        echo "[$repo] Worktree ready: $WORKTREE_PATH"
        CREATED_REPOS+=("$repo")
        CREATED_PATHS+=("$WORKTREE_PATH")
    done

    trap - ERR

    cat > "$WS_ROOT/.wt-workspace" <<WSMETA
name=$WS_NAME
repo_base=$WS_REPO_BASE
repos=$WS_REPOS
WSMETA

    if codegraph_enabled; then
        if ! command -v codegraph >/dev/null 2>&1; then
            echo
            echo "Warning: WT_CODEGRAPH=true but 'codegraph' is not on PATH, skipping indexing." >&2
        elif [ -d "$WS_ROOT/.codegraph" ]; then
            echo
            echo "Reindexing codegraph..."
            (cd "$WS_ROOT" && codegraph index --force) || echo "Warning: 'codegraph index --force' failed." >&2
        else
            echo
            echo "Initializing codegraph..."
            (cd "$WS_ROOT" && codegraph init) || echo "Warning: 'codegraph init' failed." >&2
        fi
    fi

    echo
    echo "Workspace ready:"
    echo "  $WS_ROOT"

    exit 0
fi


# ------------------------------------------------------------
# wt <branch> [--from <base-branch>]
# ------------------------------------------------------------

BRANCH="$1"
shift

FROM_BRANCH=""

if [ "$#" -gt 0 ]; then
    if [ "$1" != "--from" ]; then
        echo "Error: unknown option '$1'." >&2
        echo
        print_usage
        exit 1
    fi

    if [ "$#" -ne 2 ]; then
        echo "Usage: wt <branch> --from <base-branch>" >&2
        exit 1
    fi

    FROM_BRANCH="$2"
fi

require_repo

validate_branch_name "$BRANCH"
if [ -n "$FROM_BRANCH" ]; then
    validate_branch_name "$FROM_BRANCH"
fi

# Update remote references before looking for the branch
git fetch --all --prune

# Clear out stale worktree registrations left behind by manually removing
# a worktree directory (e.g. 'rm -rf') instead of using 'wt remove'
git worktree prune

# Check if branch is already checked out in another worktree
if worktree_exists_for_branch "$BRANCH"; then
    echo "Error: branch '$BRANCH' is already checked out in another worktree." >&2
    echo
    git worktree list
    exit 1
fi

# Worktree path (always relative to the repo root, not the cwd)
WORKTREE_PATH="$REPO_ROOT/$BRANCH"


# ------------------------------------------------------------
# Existing local branch
# ------------------------------------------------------------

if git show-ref --verify --quiet "refs/heads/$BRANCH"; then

    if [ -n "$FROM_BRANCH" ]; then
        echo "Warning: branch '$BRANCH' already exists locally, ignoring --from '$FROM_BRANCH'." >&2
    fi

    echo "Local branch found: $BRANCH"
    echo "Creating worktree: $WORKTREE_PATH"

    git worktree add "$WORKTREE_PATH" "$BRANCH"


# ------------------------------------------------------------
# Existing remote branch
# ------------------------------------------------------------

elif git show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then

    if [ -n "$FROM_BRANCH" ]; then
        echo "Warning: branch '$BRANCH' already exists on origin, ignoring --from '$FROM_BRANCH'." >&2
    fi

    echo "Remote branch found: origin/$BRANCH"
    echo "Creating tracking branch: $BRANCH"
    echo "Creating worktree: $WORKTREE_PATH"

    git worktree add \
        --track \
        -b "$BRANCH" \
        "$WORKTREE_PATH" \
        "origin/$BRANCH"


# ------------------------------------------------------------
# New branch
# ------------------------------------------------------------

else

    if [ -n "$FROM_BRANCH" ]; then

        if git show-ref --verify --quiet "refs/heads/$FROM_BRANCH"; then
            START_POINT="$FROM_BRANCH"
        elif git show-ref --verify --quiet "refs/remotes/origin/$FROM_BRANCH"; then
            START_POINT="origin/$FROM_BRANCH"
        else
            echo "Error: base branch '$FROM_BRANCH' not found locally or on origin." >&2
            exit 1
        fi

        echo "Branch '$BRANCH' does not exist."
        echo "Creating new branch from: $START_POINT"
        echo "Creating worktree: $WORKTREE_PATH"

    else

        DEFAULT_BRANCH="$(git symbolic-ref --short refs/remotes/origin/HEAD)"
        DEFAULT_BRANCH="${DEFAULT_BRANCH#origin/}"
        START_POINT="origin/$DEFAULT_BRANCH"

        echo "Branch '$BRANCH' does not exist."
        echo "Creating new branch from: $DEFAULT_BRANCH"
        echo "Creating worktree: $WORKTREE_PATH"

    fi

    # --no-track: without it, git auto-configures the new branch's upstream
    # to the start-point branch whenever it's a remote-tracking branch,
    # which later confuses a plain 'git push' on this branch.
    git worktree add \
        --no-track \
        -b "$BRANCH" \
        "$WORKTREE_PATH" \
        "$START_POINT"

fi


echo
echo "Worktree ready:"
echo "  $WORKTREE_PATH"
echo
echo "To enter it:"
echo "  cd '$WORKTREE_PATH'"
